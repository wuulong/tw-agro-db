# .gitignore for tw-agro-db (台灣農業開放大數據引擎)

# 1. 二進位 SQLite 資料庫 (不 Commit 進入 Git，由 CI/CD 或 Release Assets 部署)
db/*.db
db/*.sqlite
*.sqlite3

# 2. 全量巨量原始數據 (不 Commit 進入 Git，僅保留 data/samples/ 微型測試範例)
data/raw/

# 3. Python 臨時與緩存檔案
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# 4. 系統與 IDE 檔案
.DS_Store
.vscode/
.idea/
